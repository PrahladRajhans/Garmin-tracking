# Official Personal API key: prefer the key file ~/.config/garmin/connect-personal-api-key.
# If you use this variable instead, keep .env out of git (it is in .gitignore).
GARMIN_PERSONAL_API_KEY=
# Unofficial fallback login, only if you skip `python -m garmin_mcp.login`.
GARMIN_EMAIL=
GARMIN_PASSWORD=
GARMIN_TOKEN_DIR=~/.garminconnect
GARMIN_DATA_DIR=~/.garmin-mcp
# Optional private phone hosting. Keep disabled until MAC_SETUP.md checks are complete.
GARMIN_DASHBOARD_PUBLISH=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
GARMIN_CLOUDFLARE_PROJECT=
GARMIN_DASHBOARD_EMAIL=
# Absolute path, e.g. /Users/you/.garmin-mcp/cloudflare/node_modules/.bin/wrangler
GARMIN_WRANGLER=
